# ローカル開発用テンプレート。`cp .env.local.example .env.local` して使う。
# .env.local はコミットしない（.gitignore 対象）。
#
# 本番向けの正準テンプレートは .env.example（fail-closed で空値）。
# 開発専用の値はこちらにだけ置き、.env.example へは書き戻さないこと。

# Google Identity Services（GIS）トークンモデル用の公開 Client ID。
# 取得手順は docs/google-sheets-sync-design.md 付録 B（Google Cloud Console 設定）を参照。
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# サイトマップ（app/sitemap.ts）が絶対 URL を組み立てるための公開オリジン。
#
# 注意: `bun run build`（= NODE_ENV=production）は localhost と平文 http を**拒否する**。
# 開発既定値のまま本番用 sitemap を出力させないための fail-closed 検証で、ローカル検証ビルドにも同じく効く。
# したがって、`bun run dev` と `bun run build` の両方を回すなら **https の公開ドメインを入れておく**のが楽。
# （`next dev` は sitemap のオリジンに依存しないため、この値が本番ドメインでも開発の妨げにならない。）
NEXT_PUBLIC_SITE_URL=https://example.com

# sitemap を出力しない用途で `next dev` だけを回す場合は localhost でもよい（build は失敗する）:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
